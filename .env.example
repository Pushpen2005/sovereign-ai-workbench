# SovereignAI Environment Configuration Template
# Duplicate this file to .env and adjust variables as needed.

# ─── Service Ports ──────────────────────────────────────────────────────────
PORT=9000
AI_SERVICE_PORT=5001
FRONTEND_PORT=5173

# ─── PostgreSQL Database ───────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench_secret
POSTGRES_DB=workbench_db

# ─── Qdrant Vector Store ────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ─── Ollama Local LLM ──────────────────────────────────────────────────────
# When running Ollama in Compose: http://ollama:11434
# When using host-accelerated Ollama (e.g. macOS Metal): http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# ─── Internal Service Discovery ─────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:5001

# ─── Organization Context Defaults ──────────────────────────────────────────
DEFAULT_ORGANIZATION_ID=0bd5dba2-05e1-4f5c-9047-25843d338622
DEFAULT_ORGANIZATION_NAME=Demo Organization

# ─── Python Path for DOCX Generator ─────────────────────────────────────────
PYTHON_PATH=python3

# ─── Frontend Client API Base URL ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:9000
