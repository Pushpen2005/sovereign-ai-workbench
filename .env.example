# SovereignAI Environment Configuration Template
# Duplicate this file to .env and adjust variables as needed.

# ─── Service Ports ──────────────────────────────────────────────────────────
PORT=9000
AI_SERVICE_PORT=5001
FRONTEND_PORT=5173

# ─── PostgreSQL Database ───────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=workbench
POSTGRES_PASSWORD=workbench_secret
POSTGRES_DB=workbench_db

# ─── Qdrant Vector Store ────────────────────────────────────────────────────
QDRANT_URL=http://qdrant:6333

# ─── Ollama Local LLM ──────────────────────────────────────────────────────
# When running Ollama in Compose: http://ollama:11434
# When using host-accelerated Ollama (e.g. macOS Metal): http://host.docker.internal:11434
OLLAMA_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b

# ─── Internal Service Discovery ─────────────────────────────────────────────
AI_SERVICE_URL=http://ai-service:5001

# ─── Organization Context Defaults ──────────────────────────────────────────
DEFAULT_ORGANIZATION_ID=0bd5dba2-05e1-4f5c-9047-25843d338622
DEFAULT_ORGANIZATION_NAME=Demo Organization

# ─── Python Path for DOCX Generator ─────────────────────────────────────────
PYTHON_PATH=python3

# ─── Frontend Client API Base URL ───────────────────────────────────────────
VITE_API_BASE_URL=http://localhost:9000

# ─── Model Router (PR #23) ───────────────────────────────────────────────────
# Centralized model selection — all task types are routed to the configured
# local Ollama model.  Changing a model name here requires no code changes.
#
# DEFAULT_MODEL: used for GENERAL tasks and as the fallback baseline.
# DOCUMENT_MODEL: used for document analysis, RAG, and inspection queries.
# CODING_MODEL: used for code generation and debugging requests.
#   → Set to a coding-optimised model (e.g. qwen2.5-coder:7b) when available.
#   → Defaults to DEFAULT_MODEL when left unset.
# VISION_MODEL (PR #25): used for multimodal visual inspection of engineering images.
#   → Set to a local multimodal model (e.g. moondream:1.8b or llama3.2-vision:11b).
#   → Pull via: ollama pull moondream

DEFAULT_MODEL=llama3.2:3b
DOCUMENT_MODEL=llama3.2:3b
CODING_MODEL=llama3.2:3b
CODING_MODEL_FALLBACK=true
VISION_MODEL=moondream

# ─── LangGraph Orchestration Engines ─────────────────────────────────────────
# Feature flags controlling workflow engines. Defaults to "langgraph".
# Options: "langgraph" (authoritative StateGraph) | "legacy" (imperative fallback)
AGENT_ORCHESTRATOR=langgraph
INSPECTION_ORCHESTRATOR=langgraph

# ─── Authentication & Multi-Tenant Authorization (Phase 2) ───────────────────
# JWT Secret: Provide a secure 32+ character key in production.
# Never commit production secrets to source control.
JWT_SECRET=sovereign-ai-workbench-dev-jwt-secret-key-replace-in-production
JWT_EXPIRES_IN=7d

# Default Demo Account (SIH Evaluation)
DEMO_USER_EMAIL=engineer@example.com
DEMO_USER_PASSWORD=DemoPassword123!

# ─── CORS Configuration ───────────────────────────────────────────────────────
# Explicit comma-separated whitelist of allowed frontend origins.
# Wildcard '*' is disallowed in production.
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:3000

